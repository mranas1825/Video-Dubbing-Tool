+"""
+Dependency checker for the DubCraft AI video dubbing pipeline.
+
+Run this BEFORE starting the app to verify that the Python environment is set up
+correctly and all required packages are installed. It prints a PASS/FAIL status
+for every dependency used by backend_bridge.py and its modules.
+
+Usage:
+    python python/check_dependencies.py
+"""
+import sys
+import subprocess
+
+CHECKS = [
+    # (module_name, pip_package_name, human description)
+    ("dotenv", "python-dotenv", "Environment variables loader"),
+    ("edge_tts", "edge-tts", "Free neural text-to-speech (Microsoft Edge)"),
+    ("anthropic", "anthropic", "Claude AI script rewrite (optional but imported)"),
+    ("faster_whisper", "faster-whisper", "Whisper speech transcription"),
+    ("demucs", "demucs", "AI vocal/ambient separation"),
+    ("imageio_ffmpeg", "imageio-ffmpeg", "Bundled FFmpeg binary"),
+    ("yt_dlp", "yt-dlp", "Video link downloader"),
+    ("pydub", "pydub", "Audio manipulation"),
+]
+
+def check_ffmpeg():
+    try:
+        subprocess.run(["ffmpeg", "-version"], capture_output=True, check=True)
+        return True, "FFmpeg found on PATH"
+    except FileNotFoundError:
+        return False, "FFmpeg NOT found on PATH — install FFmpeg and add it to PATH"
+    except Exception:
+        return False, "FFmpeg check failed"
+
+def main():
+    print("=" * 70)
+    print("  DubCraft AI — Python Dependency Checker")
+    print(f"  Python: {sys.version}  ({sys.executable})")
+    print("=" * 70)
+
+    missing = []
+    for module, package, desc in CHECKS:
+        try:
+            __import__(module)
+            print(f"  [PASS] {package:<22} ({desc})")
+        except ImportError:
+            missing.append(package)
+            print(f"  [FAIL] {package:<22} ({desc})")
+
+    ffmpeg_ok, ffmpeg_msg = check_ffmpeg()
+    print(f"  [{'PASS' if ffmpeg_ok else 'FAIL'}] {'ffmpeg':<22} ({ffmpeg_msg})")
+
+    print("=" * 70)
+    if missing or not ffmpeg_ok:
+        print("RESULT: NOT READY — some dependencies are missing.\n")
+        print("To fix, run in the project root folder:")
+        print("  python -m venv venv")
+        if sys.platform == "win32":
+            print("  venv\\Scripts\\Activate.ps1   (Windows PowerShell)")
+        else:
+            print("  source venv/bin/activate     (Linux/macOS)")
+        print("  pip install -r python/requirements.txt")
+        if not ffmpeg_ok:
+            print("  Also install FFmpeg: https://ffmpeg.org/download.html")
+        sys.exit(1)
+    else:
+        print("RESULT: ALL GOOD — environment is ready to run the dubbing pipeline.")
+        sys.exit(0)
+
+if __name__ == "__main__":
+    main()
